<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Mecena Motion @VERSION@</title>
    <organization>it.mecena</organization>
    <welcome file="welcome.html" mime-type="text/html"/>
    <license file="LICENSE.txt" mime-type="text/plain"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="never" require-scripts="true" rootVolumeOnly="true" hostArchitectures="@ARCH@"/>
    <domains enable_localSystem="true"/>
    <volume-check>
        <allowed-os-versions><os-version min="12.0"/></allowed-os-versions>
    </volume-check>
    <choices-outline><line choice="default"><line choice="it.mecena.motion.pkg"/></line></choices-outline>
    <choice id="default"/>
    <choice id="it.mecena.motion.pkg" visible="false"><pkg-ref id="it.mecena.motion.pkg"/></choice>
    <pkg-ref id="it.mecena.motion.pkg" version="@VERSION@" onConclusion="none">MecenaMotion-core.pkg</pkg-ref>
</installer-gui-script>
