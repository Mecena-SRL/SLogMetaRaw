<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- SPDX-License-Identifier: GPL-3.0-or-later. One Audio Unit of Log MetaRaw Audio (filled in by CMakeLists.txt). -->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>Italian</string>
	<key>CFBundleExecutable</key>
	<string>@AU_NAME@</string>
	<key>CFBundleIdentifier</key>
	<string>@AU_BUNDLE_ID@</string>
	<key>CFBundleName</key>
	<string>@AU_NAME@</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundlePackageType</key>
	<string>BNDL</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleShortVersionString</key>
	<string>@AU_VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@AU_VERSION@</string>
	<key>AudioComponents</key>
	<array>
		<dict>
			<key>factoryFunction</key>
			<string>AUWrapperFactory</string>
			<key>description</key>
			<string>@AU_NAME@</string>
			<key>manufacturer</key>
			<string>Mcna</string>
			<key>name</key>
			<string>Mecena SRL: @AU_NAME@</string>
			<key>subtype</key>
			<string>@AU_SUBTYPE@</string>
			<key>type</key>
			<string>aufx</string>
			<key>version</key>
			<integer>@AU_VERSION_INT@</integer>
		</dict>
	</array>
	<key>AudioUnit SupportedNumChannels</key>
	<array>
		<dict>
			<key>Inputs</key>
			<string>2</string>
			<key>Outputs</key>
			<string>2</string>
		</dict>
		<dict>
			<key>Inputs</key>
			<string>1</string>
			<key>Outputs</key>
			<string>1</string>
		</dict>
	</array>
</dict>
</plist>
