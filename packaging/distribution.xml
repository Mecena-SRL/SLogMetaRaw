<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Log MetaRaw @VERSION@</title>
    <background file="background.png" alignment="bottomleft" scaling="none"/>
    <background-darkAqua file="background.png" alignment="bottomleft" scaling="none"/>
    <welcome file="welcome.html" mime-type="text/html"/>
    <license file="license.txt"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true"/>
    <os-version min="12.0"/>
    <choices-outline>
        <line choice="default"/>
    </choices-outline>
    <choice id="default" title="Log MetaRaw">
        <pkg-ref id="com.slogmetaraw.pkg"/>
        <pkg-ref id="it.mecena.motion.pkg"/>
    </choice>
    <pkg-ref id="com.slogmetaraw.pkg" version="@VERSION@" onConclusion="none">SLogMetaRaw-component.pkg</pkg-ref>
    <pkg-ref id="it.mecena.motion.pkg" version="@MOTION_VERSION@" onConclusion="none">MecenaMotion-component.pkg</pkg-ref>
</installer-gui-script>
