    "    float hts = 1.0f - tpt;\n"
    "    const float hcc = (hts * (1.0f - ach) + ach * (1.0f - hts)) * ach * hr;\n"
    "    hts = SM_POW(hts, 1.0f / 0.3f);\n"
    "    const float hf = hcc - 2.0f * hcc * hts + 1.0f;\n"
    "    c.y *= hf;\n"
    "    c.z *= hf;\n"
    "    // hue shift RGB, then CMY (only C)\n"
    "    const float sr = 0.6f * hsr * ach * SM_POW(tpt, 1.0f / 0.6f), sg = -0.35f * hg * ach * tpt;\n"
    "    const float sb = -0.66f * hsb * ach * tpt, sc = -0.25f * hc * ach * (1.0f - tpt);\n"
    "    c = smf3(c.x + sb - sg, c.y + sr - sb + sc, c.z + sg - sr - sc);\n"
    "\n"
    "    // purity compression: limits low and high, mid-range purity\n"
    "    float ptf = 1.0f - SM_POW(tpt, 1.0f + 4.0f * (1.0f - tpt) * (0.25f + 0.5f * hsr + 0.1f * hsb));\n"
    "    ptf = SM_POW(ptf, (1.0f - 0.5f * ach * hsr) * (1.0f - 0.25f * ach));\n"
    "    const float ul = 1.0f - tpt, ul2 = ul * ul;\n"
    "    ptf *= (1.0f + 0.4f * SM_EXP(-4.0f * ach * ach) * ul2 * ul2)\n"
    "         * (1.0f - 0.8f * SM_EXP(-5.0f * ach * ach) * SM_POW(tpt, 1.0f / 1.4f));\n"
    "    c = smf3(c.x * ptf + 1.0f - ptf, c.y * ptf + 1.0f - ptf, c.z * ptf + 1.0f - ptf);\n"
    "\n"
    "    // inverse render space, into Rec.709\n"
    "    l = 0.35f * (0.25f * c.x + 0.2f * c.y + 0.55f * c.z);\n"
    "    c = sm_mul(SM_ODRT_M, 9, smf3((c.x - l) / 0.65f, (c.y - l) / 0.65f, (c.z - l) / 0.65f));\n"
    "    // post brilliance\n"
    "    ox = c.x - c.z;\n"
    "    oy = c.y - 0.5f * (c.x + c.z);\n"
    "    float bd = 0.25f * SM_SQRT(ox * ox + oy * oy);\n"
    "    bd = 1.1f * bd * bd / (bd + 0.1f);\n"
    "    const float bp = SM_EXP2((-0.5f - ach * (1.25f * hr + 1.25f * hg + 0.25f * hb)) * bd * tsn);\n"
    "    // purity softclip, final tonescale, back from the ratios\n"
    "    tsn = sm_odrt_toe(tsn * 1.01004153f);\n"
    "    c = smf3(sm_odrt_softplus(c.x * bp, 0.06f) * tsn, sm_odrt_softplus(c.y * bp, 0.08f) * tsn,\n"
    "             sm_odrt_softplus(c.z * bp, 0.06f) * tsn);\n"
    "    return smf3(sm_clamp(c.x, 0.0f, 1.0f), sm_clamp(c.y, 0.0f, 1.0f), sm_clamp(c.z, 0.0f, 1.0f));\n"
    "}\n"
    "\n"
    "SM_FN SMf3 sm_display(SMf3 xyz, int mode, int space) {\n"
    "    SMf3 c;\n"
    "    if (mode == SM_DRT_ACES2) {\n"
    "        c = sm_from_xyz(sm_to_xyz(sm_aces2(sm_from_xyz(xyz, 9)), 1), space);\n"
    "    } else if (mode == SM_DRT_ACES13) {\n"
    "        const SMf3 a = sm_mul(SM_ACES_M, 9, sm_rgc_ap1(xyz));\n"
    "        c = sm_from_xyz(sm_to_xyz(sm_aces_odt(sm_aces_rrt(a)), 10), space);\n"
    "    } else if (mode == SM_DRT_OPENDRT) {\n"
    "        c = sm_from_xyz(sm_to_xyz(sm_opendrt(xyz), 1), space);\n"
    "    } else if (mode == SM_DRT_LUMINANCE) {\n"
    "        c = sm_drt_into_display(xyz, space);\n"
    "        const float n = SM_MAX(c.x, SM_MAX(c.y, c.z));\n"
    "        if (n <= 0.0f) return smf3(0.0f, 0.0f, 0.0f);\n"
    "        const float nt = sm_drt_tonescale(n), w2 = nt * nt, w4 = w2 * w2, w = w4 * w4;   // path to white: nt^8\n"
    "        c = smf3(nt * (c.x / n + w * (1.0f - c.x / n)), nt * (c.y / n + w * (1.0f - c.y / n)),\n"
    "                 nt * (c.z / n + w * (1.0f - c.z / n)));\n"
    "    } else {   // SM_DRT_FILMIC\n"
    "        c = sm_drt_into_display(xyz, space);\n"
    "        const int o = space * 9 + 3;   // the luminance row of the gamut\n"
    "        const float y = SM_RGB_TO_XYZ[o] * c.x + SM_RGB_TO_XYZ[o + 1] * c.y + SM_RGB_TO_XYZ[o + 2] * c.z;\n"
    "        c = smf3(sm_drt_tonescale(0.8f * c.x + 0.2f * y), sm_drt_tonescale(0.8f * c.y + 0.2f * y),\n"
    "                 sm_drt_tonescale(0.8f * c.z + 0.2f * y));\n"
    "        const float yt = SM_RGB_TO_XYZ[o] * c.x + SM_RGB_TO_XYZ[o + 1] * c.y + SM_RGB_TO_XYZ[o + 2] * c.z;\n"
    "        c = smf3((c.x - 0.18f * yt) / 0.82f, (c.y - 0.18f * yt) / 0.82f, (c.z - 0.18f * yt) / 0.82f);\n"
    "    }\n"
    "    return smf3(sm_clamp(c.x, 0.0f, 1.0f), sm_clamp(c.y, 0.0f, 1.0f), sm_clamp(c.z, 0.0f, 1.0f));\n"
    "}\n"
    "\n"
    "// Vibrance luci, after the rendering: the chroma of display-linear c grows where it is bright and little\n"
    "// saturated (an overexposed sky), not where it is already saturated (an LED). Luminance stays; every channel\n"
    "// stays in 0..1. a = 0..1, up to 3x the chroma.\n"
    "SM_FN SMf3 sm_highlight_vibrance(SMf3 c, float a, int space) {\n"
    "    const int o = space * 9 + 3;\n"
    "    const float y = SM_RGB_TO_XYZ[o] * c.x + SM_RGB_TO_XYZ[o + 1] * c.y + SM_RGB_TO_XYZ[o + 2] * c.z;\n"
    "    const float mx = SM_MAX(c.x, SM_MAX(c.y, c.z)), mn = SM_MIN(c.x, SM_MIN(c.y, c.z));\n"
    "    if (a <= 0.0f || mx <= 0.0f) return c;\n"
    "    const float u = 1.0f - (mx - mn) / mx, h = sm_clamp((y - 0.25f) / 0.6f, 0.0f, 1.0f);\n"
    "    float m = 1.0f + 2.0f * a * u * u * h * h * (3.0f - 2.0f * h);\n"
    "    const float d[3] = { c.x - y, c.y - y, c.z - y };   // the largest m keeping y + m d inside 0..1\n"
    "    for (int i = 0; i < 3; ++i) {\n"
    "        if (d[i] > 0.0f) m = SM_MIN(m, (1.0f - y) / d[i]);\n"
    "        else if (d[i] < 0.0f) m = SM_MIN(m, y / -d[i]);\n"
    "    }\n"
    "    m = SM_MAX(m, 1.0f);\n"
    "    return smf3(y + m * d[0], y + m * d[1], y + m * d[2]);\n"
    "}\n"
    "\n"
    "// ---- math/Develop.h\n"
    "// SPDX-License-Identifier: GPL-3.0-or-later\n"
    "\n"
    "SM_FN SMf3 sm_develop(SMf3 in, SM_CREF(DevelopParams) p) {\n"
    "    if (p.bypass != 0 && p.levelFix == 0) return in;\n"
    "    SMf3 lin = smf3(sm_decode(in.x, p.nodeGamma), sm_decode(in.y, p.nodeGamma),\n"
    "                    sm_decode(in.z, p.nodeGamma));\n"
    "    lin = sm_fix_levels(lin, p);\n"
    "    if (p.bypass != 0)   // data level only: the develop is off for this clip\n"
    "        return smf3(sm_encode(lin.x, p.nodeGamma), sm_encode(lin.y, p.nodeGamma),\n"
    "                    sm_encode(lin.z, p.nodeGamma));\n"
    "    lin = smf3(lin.x * p.expo, lin.y * p.expo, lin.z * p.expo);\n"
    "    SMf3 xyz = sm_to_xyz(lin, p.nodeSpace);\n"
    "\n"
    "    // white balance: von Kries in Bradford LMS, as-shot white -> chosen white\n"
    "    SMf3 lms = sm_mul(SM_BRADFORD, 0, xyz);\n"
    "    lms = smf3(lms.x * p.ratioL, lms.y * p.ratioM, lms.z * p.ratioS);\n"
    "    xyz = sm_mul(SM_BRADFORD, 9, lms);\n"
    "    xyz = smf3(xyz.x * p.norm, xyz.y * p.norm, xyz.z * p.norm);\n"
    "\n"
    "    if (p.fcMode != 0) return sm_fc_emit(sm_false_color(xyz, sm_fc_headroom(lin, p), p), p);\n"
    "    if (p.toneOn != 0 || p.colorOn != 0 || p.curve.roofOn != 0) xyz = sm_tone5(xyz, p);\n"
    "\n"
    "    if (p.drt != 0) {   // to the display: outSpace / outGamma are a display gamut and curve\n"
    "        SMf3 d = sm_display(xyz, p.drt, p.outSpace);\n"
    "        if (p.hlVib > 0.0f) d = sm_highlight_vibrance(d, p.hlVib, p.outSpace);\n"
    "        return smf3(sm_encode(d.x, p.outGamma), sm_encode(d.y, p.outGamma), sm_encode(d.z, p.outGamma));\n"
    "    }\n"
    "    const int space = p.convert != 0 ? p.outSpace : p.nodeSpace;\n"
    "    const int gamma = p.convert != 0 ? p.outGamma : p.nodeGamma;\n"
    "    SMf3 o = sm_from_xyz(xyz, space);\n"
    "    return smf3(sm_encode(o.x, gamma), sm_encode(o.y, gamma), sm_encode(o.z, gamma));\n"
    "}\n"
    "\n"
    "// ---- math/Detail.h\n"
    "// SPDX-License-Identifier: GPL-3.0-or-later\n"
    "// Per-pixel maths of the Detail node, shared by its CPU passes and Metal kernels.\n"
    "// Reference: tests/model/detail.py (the algorithm is described there and in docs/DETAIL.md).\n"
    "\n"
    "#ifdef __METAL_VERSION__\n"
    "#define SM_GRID const device float*\n"
    "#else\n"
    "#define SM_GRID const float*\n"
    "#endif\n"
    "\n"
    "#define SM_DT_GG 4     // half-kernel lengths: guide sigma 1 px, fine texture, coarse texture on its grid\n"
    "#define SM_DT_G1 16\n"
    "#define SM_DT_GT 32\n"
    "\n"
    "SM_CONST float SM_DT_ETA = 1e-12f;\n"
    "SM_CONST float SM_DT_PSI = 0.25f;               // Texture soft limit, EV\n"
    "SM_CONST float SM_DT_CGREY = 74.5762205f;       // S-Log3 code values per stop at grey\n"
    "SM_CONST float SM_DT_FLOOR_EV = -9.5f;          // lifts fade out below this, so the noise floor stays\n"
    "SM_CONST float SM_DT_FLOOR_W = 3.0f;\n"
    "SM_CONST float SM_DT_CLARITY_W = 3.0f;\n"
    "SM_CONST float SM_DT_HAZE_MIN_T = 0.4f;\n"
    "SM_CONST float SM_DT_HAZE_G0 = 0.015625f;\n"
    "SM_CONST float SM_DT_HL_GAMMA = 0.6f;          // Local Highlights raises the kept detail by GAMMA * (1 - T')\n"
    "\n"
    "#define SM_DT_PV_MAX 25   // cells of the test print (provino)\n"
    "\n"
    "// One development curve (Zonale, Split grade): the shadow Ls lands on Lso with slope K; with two layers (two != 0) the\n"
    "// soft layer's line, through Lh at Lho with slope K2, is joined to it by a smooth minimum. kind: 0 one line with toe and\n"
    "// shoulder, 1 two layers, 2 a bare line (the first stage of Unito). mark: the cell of the current exposures in the provino.\n"
    "struct SMZdCurve {\n"
    "    float Ls, Lso, K, Hi, HiD, LoD;\n"
    "    float K2, Lh, Lho;\n"
    "    int kind, mark;\n"
    "};\n"
    "\n"
    "struct DetailParams {\n"
    "    int W, H;          // frame\n"
    "    int s, w, h;       // working grid: scale and size\n"
    "    int st, wt, ht;    // coarse texture grid\n"
    "    int space, gamma;  // input encoding\n"
    "    float rBx, rBy, r2x, r2y, r3x, r3y, rpx, rpy, rtx, rty;   // box radii on the grid, per axis\n"
    "    float eps, epsT;\n"
    "    int nG, n1, nT;    // used lengths of the half kernels below\n"
    "    float gG[SM_DT_GG];\n"
    "    float g1[SM_DT_G1];\n"
    "    float gT[SM_DT_GT];\n"
    "    SMToneCurve curve;     // Local Contrast, Shadows and zones on the base\n"
    "    int toneOn;\n"
    "    float hlE, hlStart;    // Local Highlights: the shoulder on the base with the detail split off\n"
    "    float hlT1, hlT2;      // detail kept whole up to T1, saturating by T1 + T2 (larger steps are edges)\n"
    "    float hlB1, hlB2;      // the same for the boost, smaller: on an edge it can only push a little\n"
    "    float hlTop;           // the recorded top: near it there is no detail left to keep, only the sensor clip\n"
    "    float hlAmount;        // Local Highlights < 0: its eased amount, the weight of the white taper\n"
    "    float hlWhiteLin;      // where the top lands, linear: the taper keeps the channels under it\n"
    "    float lam, tau0, clarity, clarityCenter, texture;\n"
    "    int hazeOn;\n"
    "    float hazeOmega, hazeMix, hazeLevel;\n"
    "    float hazeA[3], hazeInvA[3];\n"
    "    int view;          // 0 picture, 1 gain, 2 base, 3 zones in colour, 4 zones in grey\n"
    "    float toRef[9];    // input RGB -> Rec.2020, for the norm\n"
    "    float zoneWhite;   // the destination's white in stops over grey: zone X (views 3, 4)\n"
    "    float zoneBlack;   // its black in stops under grey: zone 0\n"
    "    int zdOn;          // Zonale, development: a curve on the pixel's own L (dt_zonal_gain)\n"
    "    SMZdCurve zd;\n"
    "    int zd1On;         // Unito: the development first (a bare line), then the print's curve zd\n"
    "    SMZdCurve zd1;\n"
    "    // the test print: a grid of cells, each developed with its own exposures; row 0 on top\n"
    "    int pvOn, pvCols, pvRows, pvBw;\n"
    "    SMZdCurve pv[SM_DT_PV_MAX];\n"
    "    float ebAmt, ebR0, ebS;   // the print's burned edges: stops at the edge, where the burn starts, its width\n"
    "    int pzOn;          // Zonale, presence: Texture and Clarity whole in zones II-VIII, fading to nothing at 0 and X\n"
    "    // the zone views' legend, in pixels from the bottom left: the bar 0-X (rows y0..y1), the ticks over it, the band\n"
    "    int lgOn, lgM, lgY0, lgY1, lgTop, lgX0, lgX1, lgSc, lgTk, lgTh, lgTw;\n"
    "    int lgIn[2], lgOut[2];   // where the shadow and the highlight were read and where they land: x of each tick\n"
    "};\n"
    "\n"
    "// Zonale, development: the shadow Ls lands on Lso, the line turns about it with slope k (N+/N-) up to the placed\n"
    "// highlight hi; under the shadow a toe, over the highlight a shoulder, each with the line's slope where it starts.\n"
    "// Two layers (Split grade): the hard layer's line and the soft layer's, the lower of the two (smooth, 0.5 stop).\n"
    "SM_FN float dt_zonal_curve(float L, SMZdCurve c) {\n"
    "    float y = c.Lso + c.K * (L - c.Ls);\n"
    "    if (c.kind == 2) return y;\n"
    "    if (c.kind == 1) {\n"
    "        float y2 = c.Lho + c.K2 * (L - c.Lh);\n"
    "        y = 0.5f * (y + y2 - SM_SQRT((y - y2) * (y - y2) + 0.25f));\n"
    "    }\n"
    "    if (y > c.Hi) y = c.Hi + c.HiD * (1.0f - SM_EXP(-(y - c.Hi) / c.HiD));\n"
    "    else if (y < c.Lso) y = c.Lso - c.LoD * (1.0f - SM_EXP(-(c.Lso - y) / c.LoD));\n"
    "    return y;\n"
    "}\n"
    "\n"
    "// The test print's cell of a pixel (row 0 on top; y counts from the bottom) and, on the cell's edge, its frame:\n"
    "// 1 a dark rule, 2 a light one round the cell of the current exposures. Integers only.\n"
    "SM_FN int dt_pv_cell(int x, int y, SM_CREF(DetailParams) p) {\n"
    "    int cx = x * p.pvCols / p.W, cy = (p.H - 1 - y) * p.pvRows / p.H;\n"
    "    return cy * p.pvCols + cx;\n"
    "}\n"
    "SM_FN int dt_pv_frame(int x, int y, SM_CREF(DetailParams) p) {\n"
    "    int ty = p.H - 1 - y;\n"
    "    int cx = x * p.pvCols / p.W, cy = ty * p.pvRows / p.H;\n"
    "    int dl = x - (cx * p.W + p.pvCols - 1) / p.pvCols;\n"
    "    int dr = ((cx + 1) * p.W + p.pvCols - 1) / p.pvCols - 1 - x;\n"
    "    int dt = ty - (cy * p.H + p.pvRows - 1) / p.pvRows;\n"
    "    int db = ((cy + 1) * p.H + p.pvRows - 1) / p.pvRows - 1 - ty;\n"
    "    int d = dl < dr ? dl : dr;\n"
    "    d = d < dt ? d : dt;\n"
    "    d = d < db ? d : db;\n"
    "    if (d >= p.pvBw) return 0;\n"
    "    return p.pv[cy * p.pvCols + cx].mark != 0 ? 2 : 1;\n"
    "}\n"
    "\n"
    "// The print's burned edges: a superellipse distance, 1 at the middle of each side, the burn growing smoothly over\n"
    "// its outer ebS. Position only: no neighbours, no halo.\n"
    "SM_FN float dt_edge_burn(int x, int y, SM_CREF(DetailParams) p) {\n"
    "    float u = 2.0f * ((float)x + 0.5f) / (float)p.W - 1.0f;\n"
    "    float w = 2.0f * ((float)y + 0.5f) / (float)p.H - 1.0f;\n"
    "    float r = SM_SQRT(SM_SQRT(u * u * u * u + w * w * w * w));\n"
    "    float t = sm_clamp((r - p.ebR0) / p.ebS, 0.0f, 1.0f);\n"
    "    return -p.ebAmt * t * t * (3.0f - 2.0f * t);\n"
    "}\n"
    "\n"
    "SM_FN float dt_luma(SMf3 x, SM_CREF(DetailParams) p) {\n"
    "    SMf3 r = smf3(p.toRef[0] * x.x + p.toRef[1] * x.y + p.toRef[2] * x.z,\n"
    "                  p.toRef[3] * x.x + p.toRef[4] * x.y + p.toRef[5] * x.z,\n"
    "                  p.toRef[6] * x.x + p.toRef[7] * x.y + p.toRef[8] * x.z);\n"
    "    return sm_clamp(sm_t5_log(sm_t5_norm(r)), -16.0f, 16.0f);   // fmax/fmin: NaN -> -16\n"
    "}\n"
    "\n"
    "// The noise floor in EV at log2 luminance B: larger where S-Log3 spends fewer codes per stop.\n"
    "SM_FN float dt_tau(float B, float tau0) {\n"
    "    float n = SM_T5_GREY * SM_EXP2(B);\n"
    "    float c = n >= 0.01125f ? 78.71934387f * n / (n + 0.01f) : 4695.551191f * n;\n"
    "    return SM_MIN(1.0f, tau0 * SM_DT_CGREY / c);\n"
    "}\n"
    "\n"
    "// x up to t1, then saturating smoothly to t1 + t2.\n"
    "SM_FN float dt_lim(float x, float t1, float t2) {\n"
    "    float a = SM_ABS(x);\n"
    "    if (a <= t1) return x;\n"
    "    float v = t1 + t2 * SM_TANH((a - t1) / t2);\n"
    "    return x < 0.0f ? -v : v;\n"
    "}\n"
    "\n"
    "SM_FN float dt_soft1(float g) {\n"
    "    float a = SM_ABS(g);\n"
    "    if (a <= 1.0f) return g;\n"
    "    float v = 1.0f + 0.5f * SM_TANH((a - 1.0f) / 0.5f);\n"
    "    return g < 0.0f ? -v : v;\n"
    "}\n"
    "\n"
    "SM_FN float dt_bilinear(SM_GRID grid, int w, int h, int s, int x, int y) {\n"
    "    float u = sm_clamp(((float)x + 0.5f) / (float)s - 0.5f, 0.0f, (float)(w - 1));\n"
    "    float v = sm_clamp(((float)y + 0.5f) / (float)s - 0.5f, 0.0f, (float)(h - 1));\n"
    "    int i0 = (int)u, j0 = (int)v;\n"
    "    int i1 = i0 + 1 < w ? i0 + 1 : w - 1, j1 = j0 + 1 < h ? j0 + 1 : h - 1;\n"
    "    float fx = u - (float)i0, fy = v - (float)j0;\n"
    "    float top = grid[j0 * w + i0] + (grid[j0 * w + i1] - grid[j0 * w + i0]) * fx;\n"
    "    float bot = grid[j1 * w + i0] + (grid[j1 * w + i1] - grid[j1 * w + i0]) * fx;\n"
    "    return top + (bot - top) * fy;\n"
    "}\n"
    "\n"
    "SM_FN float dt_dark_energy(SMf3 xa) {   // xa = x / A per channel: a soft minimum of the three\n"
    "    return (SM_EXP(-sm_clamp(xa.x, 0.0f, 1.5f) / 0.05f) + SM_EXP(-sm_clamp(xa.y, 0.0f, 1.5f) / 0.05f)\n"
    "            + SM_EXP(-sm_clamp(xa.z, 0.0f, 1.5f) / 0.05f)) / 3.0f;\n"
    "}\n"
    "\n"
    "SM_FN float dt_haze_channel(float c, float a, float t) {\n"
    "    if (c <= 0.0f) return c;   // no rectification of the noise at black\n"
    "    float g = 1.0f / t - (1.0f / t - 1.0f) * a / c;\n"
    "    float u = g / SM_DT_HAZE_G0;\n"
    "    return c * SM_DT_HAZE_G0 * (u >= 2.0f ? u : 1.0f + SM_EXP(u - 2.0f));\n"
    "}\n"
    "\n"
    "SM_FN SMf3 dt_haze_pixel(SMf3 x, float t, SM_CREF(DetailParams) p) {\n"
    "    if (p.hazeMix > 0.0f)\n"
    "        return smf3(p.hazeMix * p.hazeA[0] + (1.0f - p.hazeMix) * x.x, p.hazeMix * p.hazeA[1] + (1.0f - p.hazeMix) * x.y,\n"
    "                    p.hazeMix * p.hazeA[2] + (1.0f - p.hazeMix) * x.z);\n"
    "    return smf3(dt_haze_channel(x.x, p.hazeA[0], t), dt_haze_channel(x.y, p.hazeA[1], t),\n"
    "                dt_haze_channel(x.z, p.hazeA[2], t));\n"
    "}\n"
    "\n"
    "// The zone (0..X) of a log2 luminance out of the node: zone V is grey, zone 0 the destination's black, zone X its\n"
    "// white; five zones share the stops on each side. So the scale follows the output: about 7 stops for Rec.709.\n"
    "SM_FN float dt_zone_of(float Lout, float white, float black) {\n"
    "    return Lout <= 0.0f ? 5.0f + 5.0f * Lout / black : 5.0f + 5.0f * Lout / white;\n"
    "}\n"
    "\n"
    "// Everything after the filters, for one pixel: the log2 gain G, B for the views, and Local Highlights' share of G\n"
    "// with the weight of its white taper (the colour follows it to white, as in the main node).\n"
    "struct DtOut { float G; float B; float H; float W; };\n"
    "SM_FN DtOut dt_gain(float L, float Lu, float Gg, float aB, float bB, float Dg, float G1, float G2, int x, int y,\n"
    "                    SM_CREF(DetailParams) p) {\n"
    "    DtOut o;\n"
    "    float tg = 2.0f * dt_tau(Lu, p.tau0);\n"
    "    float dg = L - Gg;\n"
    "    float Lg = L - dg * tg * tg / (dg * dg + tg * tg + SM_DT_ETA);\n"
    "    float B = aB * Lg + bB;\n"
    "    float Bl = p.lam * B + (1.0f - p.lam) * L;\n"
    "    float Gb = 0.0f;\n"
    "    if (p.toneOn != 0) {\n"
    "        Gb = sm_t5_curve(Bl, p.curve).d;\n"
    "        if (Gb > 0.0f) Gb *= sm_t5_ramp((Bl - SM_DT_FLOOR_EV) / SM_DT_FLOOR_W);\n"
    "    }\n"
    "    o.H = 0.0f;\n"
    "    o.W = 0.0f;\n"
    "    if (p.hlE != 0.0f) {\n"
    "        // near the top the base is the sensor clip: the detail fades out and the curve takes the pixel whole\n"
    "        float keep = 1.0f - sm_t5_ramp((Bl - (p.hlTop - 1.5f)) / 1.5f);\n"
    "        float Dt = keep * dt_lim(L - Bl, p.hlT1, p.hlT2);\n"
    "        SMShoulder s = sm_t5_shoulder_at(L - Dt, p.hlE, p.hlStart);\n"
    "        float g = s.d;\n"
    "        if (p.hlE < 0.0f) {   // a recovery: the detail gains contrast but no pixel ends up brighter\n"
    "            float Db = keep * dt_lim(L - Bl, p.hlB1, p.hlB2);\n"
    "            float tn = 3.0f * dt_tau(L - Dt, p.tau0);\n"
    "            g = SM_MIN(g - SM_DT_HL_GAMMA * s.s * Db * Db * Db / (Db * Db + tn * tn + SM_DT_ETA), 0.0f);\n"
    "            o.H = g;\n"
    "            o.W = p.hlAmount * s.w;\n"
    "        }\n"
    "        Gb += g;\n"
    "    }\n"
    "    float K = 0.0f;\n"
    "    if (p.clarity != 0.0f) {\n"
    "        float z = (B - p.clarityCenter) / SM_DT_CLARITY_W;\n"
    "        K = p.clarity * SM_EXP(-z * z) * Dg;\n"
    "    }\n"
    "    float Tx = 0.0f;\n"
    "    if (p.texture != 0.0f) {\n"
    "        float dt = G1 - G2;\n"
    "        float ta = dt_tau(B, p.tau0);\n"
    "        float gate = p.texture > 0.0f ? dt * dt / (dt * dt + ta * ta + SM_DT_ETA) : 1.0f;\n"
    "        float q = dt / SM_DT_PSI;\n"
    "        Tx = p.texture * dt / (1.0f + q * q) * gate;\n"
    "    }\n"
    "    float Gz = 0.0f;\n"
    "    if (p.zdOn != 0) {\n"
    "        float Lc = p.zd1On != 0 ? dt_zonal_curve(L, p.zd1) : L;\n"
    "        Gz = dt_zonal_curve(Lc, p.pvOn != 0 ? p.pv[dt_pv_cell(x, y, p)] : p.zd) - L;\n"
    "        if (Gz > 0.0f) Gz *= sm_t5_ramp((L - SM_DT_FLOOR_EV) / SM_DT_FLOOR_W);\n"
    "    }\n"
    "    float wz = 1.0f;\n"
    "    if (p.pzOn != 0) {   // the zone this pixel lands on: presence where the print still shows texture (II-VIII)\n"
    "        float z = dt_zone_of(L + Gb + Gz, p.zoneWhite, p.zoneBlack);\n"
    "        wz = sm_t5_ramp((z - 0.5f) / 1.5f) * sm_t5_ramp((9.5f - z) / 1.5f);\n"
    "    }\n"
    "    o.G = Gb + dt_soft1((K + Tx) * wz);\n"
    "    if (p.zdOn != 0) o.G += Gz;\n"
    "    if (p.ebAmt != 0.0f) o.G += dt_edge_burn(x, y, p);\n"
    "    o.B = B;\n"
    "    return o;\n"
    "}\n"
    "\n"
    "// viewGain: the picture in grey where |G| < 0.1, then blue (lowered) or orange (raised) bands.\n"
    "SM_CONST float SM_DT_BLUE[12] = { 0.62f, 0.78f, 1.00f, 0.35f, 0.58f, 1.00f, 0.15f, 0.35f, 0.95f, 0.08f, 0.12f, 0.70f };\n"
    "SM_CONST float SM_DT_ORANGE[12] = { 1.00f, 0.85f, 0.60f, 1.00f, 0.68f, 0.30f, 1.00f, 0.50f, 0.10f, 0.85f, 0.25f, 0.05f };\n"
    "SM_FN SMf3 dt_view_gain(float G, float L) {\n"
    "    float a = SM_ABS(G);\n"
    "    if (a < 0.1f) {\n"
    "        float m = sm_clamp((L + 6.0f) / 11.5f, 0.06f, 0.92f);\n"
    "        return smf3(m, m, m);\n"
    "    }\n"
    "    int band = a < 0.25f ? 0 : (a < 0.5f ? 1 : (a < 1.0f ? 2 : 3));\n"
    "    if (G < 0.0f) return smf3(SM_DT_BLUE[band * 3], SM_DT_BLUE[band * 3 + 1], SM_DT_BLUE[band * 3 + 2]);\n"
    "    return smf3(SM_DT_ORANGE[band * 3], SM_DT_ORANGE[band * 3 + 1], SM_DT_ORANGE[band * 3 + 2]);\n"
    "}\n"
    "\n"
    "// viewZones: the zones of the picture out, as flat colours or as an eleven-step grey scale (display values).\n"
    "SM_CONST float SM_DT_ZONE_RGB[33] = { 0.25f, 0.00f, 0.35f,  0.10f, 0.10f, 0.55f,  0.10f, 0.35f, 0.85f,\n"
    "                                      0.00f, 0.60f, 0.70f,  0.25f, 0.65f, 0.30f,  0.50f, 0.50f, 0.50f,\n"
    "                                      0.95f, 0.65f, 0.55f,  0.95f, 0.85f, 0.25f,  1.00f, 0.60f, 0.10f,\n"
    "                                      0.95f, 0.20f, 0.10f,  1.00f, 1.00f, 1.00f };\n"
    "SM_CONST int SM_DT_GLYPH[11] = { 0x7B6F, 0x2C97, 0x73E7, 0x72CF, 0x5BC9, 0x79CF, 0x79EF, 0x7249, 0x7BEF, 0x7BCF,\n"
    "                                  0x5AAD };   // 0-9 and X, 3x5, top row first, left column the high bit\n"
    "SM_FN SMf3 dt_zone_rgb(int z, int grey) {\n"
    "    if (grey) {\n"
    "        float g = 0.1f * (float)z;\n"
    "        return smf3(g, g, g);\n"
    "    }\n"
    "    return smf3(SM_DT_ZONE_RGB[z * 3], SM_DT_ZONE_RGB[z * 3 + 1], SM_DT_ZONE_RGB[z * 3 + 2]);\n"
    "}\n"
    "// Zones 0 and X hold no detail: hatched, so what is lost shows at a glance.\n"
    "SM_FN SMf3 dt_view_zones(float Lout, int x, int y, int grey, SM_CREF(DetailParams) p) {\n"
    "    int z = (int)sm_clamp(dt_zone_of(Lout, p.zoneWhite, p.zoneBlack) + 0.5f, 0.0f, 10.0f);   // the cast is the floor\n"
    "    SMf3 c = dt_zone_rgb(z, grey);\n"
    "    if ((z == 0 || z == 10) && (x + y) % 8 < 3) return smf3(0.5f * c.x + 0.25f, 0.5f * c.y + 0.25f, 0.5f * c.z + 0.25f);\n"
    "    return c;\n"
    "}\n"
    "// The legend over the zone views: a dark band at the bottom, the bar 0-X numbered, and over it the ticks, grey where\n"
    "// the shadow and the highlight were read, white where they land. Outside the band, the view as it is.\n"
    "SM_FN SMf3 dt_legend(int x, int y, SMf3 c, int grey, SM_CREF(DetailParams) p) {\n"
    "    if (p.lgOn == 0 || y >= p.lgTop || x < p.lgX0 || x >= p.lgX1) return c;\n"
    "    SMf3 band = smf3(0.08f, 0.08f, 0.08f);\n"
    "    if (y >= p.lgY0 && y < p.lgY1 && x >= p.lgM && x < p.W - p.lgM) {\n"
    "        int span = p.W - 2 * p.lgM, u = (x - p.lgM) * 11;\n"
    "        int z = u / span;\n"
    "        if (u % span < 11) return band;   // the first column of each cell: a gap between the zones\n"
    "        int sc = p.lgSc, gl = p.lgM + (2 * z + 1) * span / 22 - 3 * sc / 2;\n"
    "        int gb = p.lgY0 + (p.lgY1 - p.lgY0 - 5 * sc) / 2;\n"
    "        if (x >= gl && x < gl + 3 * sc && y >= gb && y < gb + 5 * sc) {\n"
    "            int bit = 14 - 3 * (4 - (y - gb) / sc) - (x - gl) / sc;\n"
    "            if ((SM_DT_GLYPH[z] >> bit) & 1) {\n"
    "                float t = z >= 5 ? 0.0f : 0.95f;\n"
    "                return smf3(t, t, t);\n"
    "            }\n"
    "        }\n"
    "        return dt_zone_rgb(z, grey);\n"
    "    }\n"
    "    if (p.lgTk != 0 && y >= p.lgY1 && y < p.lgY1 + p.lgTh) {\n"
    "        for (int k = 0; k < 2; ++k)\n"
    "            if (x >= p.lgOut[k] - p.lgTw && x <= p.lgOut[k] + p.lgTw) return smf3(0.95f, 0.95f, 0.95f);\n"
    "        for (int k = 0; k < 2; ++k)\n"
    "            if (x >= p.lgIn[k] - p.lgTw / 2 && x <= p.lgIn[k] + p.lgTw / 2) return smf3(0.5f, 0.5f, 0.5f);\n"
    "    }\n"
    "    return band;\n"
    "}\n"
    "\n"
    "// The picture out, linear in the input gamut: the gain, and where Local Highlights pulls down, the path to white.\n"
    "SM_FN SMf3 dt_apply(SMf3 j, DtOut r, SM_CREF(DetailParams) p) {\n"
    "    float g = SM_EXP2(r.G);\n"
    "    j = smf3(j.x * g, j.y * g, j.z * g);\n"
    "    if (r.H < 0.0f) j = sm_from_xyz(sm_t5_hl_white(sm_to_xyz(j, p.space), r.H, r.W, p.hlWhiteLin, 1, p.space), p.space);\n"
    "    return j;\n"
    "}\n"
    "\n"
    "// A display colour (Rec.709, gamma 2.2) in the node's encoding, as the false colours do.\n"
    "SM_FN SMf3 dt_emit(SMf3 c, SM_CREF(DetailParams) p) {\n"
    "    SMf3 lin = smf3(sm_decode(c.x, 2), sm_decode(c.y, 2), sm_decode(c.z, 2));\n"
    "    SMf3 o = sm_from_xyz(sm_to_xyz(lin, 1), p.space);\n"
    "    return smf3(sm_encode(o.x, p.gamma), sm_encode(o.y, p.gamma), sm_encode(o.z, p.gamma));\n"
    "}\n"
    "\n"
    "// ---- math/HostOnly.h\n"
    "// SPDX-License-Identifier: GPL-3.0-or-later\n"
    "// CPU only: parameter preparation, never compiled into a kernel.\n"
    "#ifndef __METAL_VERSION__\n"
    "\n"
    "// Planckian locus in CIE 1960 uv (Krystek 1985): smooth, within 1.4e-4 of the Planck integral on\n"
    "// 1500-15000 K, with an analytic tangent. The Kim et al. piecewise cubic it replaces had seams at\n"
    "// 2222 K and 4000 K that made the sliders reverse.\n"
    "static const double SM_WB_KMIN = 1500.0, SM_WB_KMAX = 15000.0, SM_WB_TINT_MAX = 150.0;\n"
    "static inline void sm_locus_uv(double t, double* u, double* v, double* nu, double* nv) {\n"
    "    t = t < SM_WB_KMIN ? SM_WB_KMIN : (t > SM_WB_KMAX ? SM_WB_KMAX : t);\n"
    "    const double au = 0.860117757 + 1.54118254e-4 * t + 1.28641212e-7 * t * t;\n"
    "    const double bu = 1.0 + 8.42420235e-4 * t + 7.08145163e-7 * t * t;\n"
    "    const double av = 0.317398726 + 4.22806245e-5 * t + 4.20481691e-8 * t * t;\n"
    "    const double bv = 1.0 - 2.89741816e-5 * t + 1.61456053e-7 * t * t;\n"
    "    const double du = ((1.54118254e-4 + 2.0 * 1.28641212e-7 * t) * bu - au * (8.42420235e-4 + 2.0 * 7.08145163e-7 * t)) / (bu * bu);\n"
    "    const double dv = ((4.22806245e-5 + 2.0 * 4.20481691e-8 * t) * bv - av * (-2.89741816e-5 + 2.0 * 1.61456053e-7 * t)) / (bv * bv);\n"
    "    const double len = sqrt(du * du + dv * dv);\n"
    "    *u = au / bu;\n"
    "    *v = av / bv;\n"
    "    *nu = -dv / len;   // unit normal towards +v: a greener illuminant\n"
    "    *nv = du / len;\n"
    "    if (*nv < 0.0) { *nu = -*nu; *nv = -*nv; }\n"
    "}\n"
    "static inline void sm_uv_xyz(double u, double v, double out[3]) {\n"
    "    const double d = 2.0 * u - 8.0 * v + 4.0, x = 3.0 * u / d, y = 2.0 * v / d;\n"
    "    out[0] = x / y; out[1] = 1.0; out[2] = (1.0 - x - y) / y;\n"
    "}\n"
    "static inline double sm_bradford_s(double u, double v) {\n"
    "    double w[3];\n"
    "    sm_uv_xyz(u, v, w);\n"
    "    return (double)SM_BRADFORD[6] * w[0] + (double)SM_BRADFORD[7] * w[1] + (double)SM_BRADFORD[8] * w[2];\n"
    "}\n"
    "// A green tint at low Kelvin drives the white's Bradford S cone through zero, and the adaptation then\n"
    "// inverts. The green side is soft-limited so S keeps at least 30% of its value on the locus.\n"
    "static inline double sm_green_limit(double u, double v, double nu, double nv) {\n"
    "    const double target = 0.3 * sm_bradford_s(u, v);\n"
    "    double lo = 0.0, hi = 0.2;\n"
    "    for (int i = 0; i < 60; ++i) {\n"
    "        const double m = 0.5 * (lo + hi);\n"
    "        if (sm_bradford_s(u + nu * m, v + nv * m) > target) lo = m; else hi = m;\n"
    "    }\n"
    "    return lo;\n"
    "}\n"
    "// White of an illuminant at temperature k with tint (Duv * 3000, positive = greener illuminant, so\n"
    "// raising Tint makes the image more magenta), as XYZ with Y = 1.\n"
    "static inline void sm_white_xyz(double k, double tint, double out[3]) {\n"
    "    double u, v, nu, nv;\n"
    "    sm_locus_uv(k, &u, &v, &nu, &nv);\n"
    "    tint = tint < -SM_WB_TINT_MAX ? -SM_WB_TINT_MAX : (tint > SM_WB_TINT_MAX ? SM_WB_TINT_MAX : tint);\n"
    "    double d = tint / 3000.0;\n"
    "    if (d > 0.0) {\n"
    "        const double lim = sm_green_limit(u, v, nu, nv), a = 0.5 * lim, b = lim - a;\n"
    "        if (d > a) d = a + b * (1.0 - exp(-(d - a) / b));\n"
    "    }\n"
    "    sm_uv_xyz(u + nu * d, v + nv * d, out);\n"
    "}\n"
    "static inline void sm_bradford(const double in[3], double out[3], int inverse) {\n"
    "    const float* m = SM_BRADFORD + (inverse ? 9 : 0);\n"
    "    for (int i = 0; i < 3; ++i)\n"
    "        out[i] = m[i * 3] * in[0] + m[i * 3 + 1] * in[1] + m[i * 3 + 2] * in[2];\n"
    "}\n"
    "// White-balance fields of DevelopParams from as-shot and chosen Kelvin/tint.\n"
    "static inline void sm_set_white_balance(DevelopParams* p, double shotK, double shotTint, double k, double tint) {\n"
    "    double ws[3], wt[3], ls[3], lt[3];\n"
    "    sm_white_xyz(shotK, shotTint, ws);\n"
    "    sm_white_xyz(k, tint, wt);\n"
    "    sm_bradford(ws, ls, 0);\n"
    "    sm_bradford(wt, lt, 0);\n"
    "    double r[3] = { ls[0] / lt[0], ls[1] / lt[1], ls[2] / lt[2] };\n"
    "    const double d65[3] = { 0.95046, 1.0, 1.08906 };\n"
    "    double l65[3], lr[3], nw[3];\n"
    "    sm_bradford(d65, l65, 0);\n"
    "    for (int i = 0; i < 3; ++i) lr[i] = l65[i] * r[i];\n"
    "    sm_bradford(lr, nw, 1);\n"
    "    p->ratioL = (float)r[0];\n"
    "    p->ratioM = (float)r[1];\n"
    "    p->ratioS = (float)r[2];\n"
    "    p->norm = nw[1] > 0.0 ? (float)(1.0 / nw[1]) : 1.0f;\n"
    "}\n"
    "\n"
    "// CIE 1960 uv where a neutral (D65, the matrices' white) lands after the white balance.\n"
    "static inline void sm_neutral_uv(double shotK, double shotT, double k, double t, double* u, double* v) {\n"
    "    DevelopParams q = DevelopParams();\n"
    "    sm_set_white_balance(&q, shotK, shotT, k, t);\n"
    "    const double d65[3] = { 0.95046, 1.0, 1.08906 };\n"
    "    double lms[3], xyz[3];\n"
    "    sm_bradford(d65, lms, 0);\n"
    "    lms[0] *= q.ratioL;\n"
    "    lms[1] *= q.ratioM;\n"
    "    lms[2] *= q.ratioS;\n"
    "    sm_bradford(lms, xyz, 1);\n"
    "    const double X = xyz[0] * q.norm, Y = xyz[1] * q.norm, Z = xyz[2] * q.norm;\n"
    "    const double d = X + 15.0 * Y + 3.0 * Z;\n"
    "    *u = d > 1e-9 ? 4.0 * X / d : 0.0;\n"
    "    *v = d > 1e-9 ? 6.0 * Y / d : 0.0;\n"
    "}\n"
    "\n"
    "// Inverse of the WB sliders' response at k/t, so the temperature and tint views read in\n"
    "// slider units. Returns 0 on a degenerate basis (the caller then shows the picture).\n"
    "static inline int sm_fc_calibrate(DevelopParams* p, double k, double t) {\n"
    "    double u0, v0, uk, vk, ut, vt;\n"
    "    const double dk = k + 100.0 <= SM_WB_KMAX ? 100.0 : -100.0;   // the locus stops at KMAX\n"
    "    const double dt = t + 5.0 <= SM_WB_TINT_MAX ? 5.0 : -5.0;\n"
    "    sm_neutral_uv(k, t, k, t, &u0, &v0);\n"
    "    sm_neutral_uv(k, t, k + dk, t, &uk, &vk);\n"
    "    sm_neutral_uv(k, t, k, t + dt, &ut, &vt);\n"
    "    const double a = (uk - u0) / dk, c = (vk - v0) / dk;\n"
    "    const double b = (ut - u0) / dt, e = (vt - v0) / dt;\n"
    "    const double det = a * e - b * c;\n"
    "    p->fcU = (float)u0;\n"
    "    p->fcV = (float)v0;\n"
    "    if (fabs(det) <= 1e-12) return 0;\n"
    "    p->fcKu = (float)(e / det);\n"
    "    p->fcKv = (float)(-b / det);\n"
    "    p->fcTu = (float)(-c / det);\n"
    "    p->fcTv = (float)(a / det);\n"
    "    return 1;\n"
    "}\n"
    "\n"
    "// The eyedropper: the (k, tint) whose white balance turns one sample into a neutral. xyz is the sample in the\n"
    "// node's linear working space. The sample is seen under an illuminant lt, and the white balance maps the as-shot\n"
    "// white ls onto lt, so lt = ls * (sample in Bradford LMS) / (D65 in LMS); (k, tint) is then found on CIE 1960 uv\n"
    "// by Newton from the Kelvin of the current slider. Returns 0 when the sample has no chromaticity (black, negative\n"
    "// cone response) or the search does not settle; k and tint come back inside the sliders' range.\n"
    "static inline int sm_wb_from_xyz(double shotK, double shotT, const double xyz[3], double* k, double* tint) {\n"
    "    const double d65[3] = { 0.95046, 1.0, 1.08906 };\n"
    "    double ws[3], ls[3], l65[3], s[3], lt[3], wt[3];\n"
    "    sm_white_xyz(shotK, shotT, ws);\n"
    "    sm_bradford(ws, ls, 0);\n"
    "    sm_bradford(d65, l65, 0);\n"
    "    sm_bradford(xyz, s, 0);\n"
    "    if (!(s[0] > 0.0 && s[1] > 0.0 && s[2] > 0.0)) return 0;\n"
    "    for (int i = 0; i < 3; ++i) lt[i] = ls[i] * s[i] / l65[i];\n"
    "    sm_bradford(lt, wt, 1);\n"
    "    const double den = wt[0] + 15.0 * wt[1] + 3.0 * wt[2];\n"
    "    if (!(den > 1e-9)) return 0;\n"
    "    const double tu = 4.0 * wt[0] / den, tv = 6.0 * wt[1] / den;\n"
    "    auto uv = [](double kk, double tt, double* u, double* v) {\n"
    "        double w[3];\n"
    "        sm_white_xyz(kk, tt, w);\n"
    "        const double d = w[0] + 15.0 * w[1] + 3.0 * w[2];\n"
    "        *u = 4.0 * w[0] / d;\n"
    "        *v = 6.0 * w[1] / d;\n"
    "    };\n"
    "    double kk = 5600.0, tt = 0.0, u, v;\n"
    "    uv(kk, tt, &u, &v);\n"
    "    double err = (u - tu) * (u - tu) + (v - tv) * (v - tv);\n"
    "    for (int it = 0; it < 80 && err > 1e-14; ++it) {\n"
    "        const double dk = kk * 0.01, dt = 1.0;\n"
    "        double uk, vk, ut, vt;\n"
    "        uv(kk + dk, tt, &uk, &vk);\n"
    "        uv(kk, tt + dt, &ut, &vt);\n"
    "        const double a = (uk - u) / dk, c = (vk - v) / dk, b = (ut - u) / dt, e = (vt - v) / dt;\n"
    "        const double det = a * e - b * c;\n"
    "        if (fabs(det) < 1e-18) return 0;\n"
    "        double sk = (e * (tu - u) - b * (tv - v)) / det, st = (-c * (tu - u) + a * (tv - v)) / det;\n"
    "        double scale = 1.0;\n"
    "        for (int half = 0; half < 20; ++half, scale *= 0.5) {   // keep the step only if it gets closer\n"
    "            const double nk = fmin(fmax(kk + sk * scale, SM_WB_KMIN), SM_WB_KMAX);\n"
    "            const double nt = fmin(fmax(tt + st * scale, -SM_WB_TINT_MAX), SM_WB_TINT_MAX);\n"
    "            double nu, nv;\n"
    "            uv(nk, nt, &nu, &nv);\n"
    "            const double ne = (nu - tu) * (nu - tu) + (nv - tv) * (nv - tv);\n"
    "            if (ne < err) { kk = nk; tt = nt; u = nu; v = nv; err = ne; break; }\n"
    "            if (half == 19) it = 80;\n"
    "        }\n"
    "    }\n"
    "    if (err > 1e-8) return 0;   // ~1e-4 in uv, a few tens of Kelvin: further than that is not a white\n"
    "    *k = fmin(fmax(kk, 2000.0), 15000.0);\n"
    "    *tint = fmin(fmax(tt, -100.0), 100.0);\n"
    "    return 1;\n"
    "}\n"
    "\n"
    "// Code-value remap for a clip decoded on the wrong scale (hostFull: 1 = Resolve decoded Full).\n"
    "static inline void sm_set_level_fix(DevelopParams* p, int space, int gamma, int hostFull) {\n"
    "    p->levelFix = 1;\n"
    "    p->levelSpace = space;\n"
    "    p->levelGamma = gamma;\n"
    "    p->levelGain = hostFull ? 1023.0f / 876.0f : 876.0f / 1023.0f;\n"
    "    p->levelOffset = hostFull ? -64.0f / 876.0f : 64.0f / 1023.0f;\n"
    "}\n"
    "#endif\n"
    "\n"
    "// ---- math/ToneHost.h\n"
    "// SPDX-License-Identifier: GPL-3.0-or-later\n"
    "// CPU only: the tone policy, from the raw panel values to DevelopParams, in double.\n"
    "#ifndef __METAL_VERSION__\n"
    "\n"
    "// The panel as the colourist sees it: -100..100 sliders, zones in stops (Black, Shadow, Light, Specular).\n"
    "struct SMToneControls {\n"
    "    double contrast, highlights, shadows, whites, blacks, vibrance, saturation;\n"
    "    double zonePivot, zoneExp[4], zoneSat[4], zoneRange[4], zoneFalloff[4];\n"
    "    int softClip;\n"
    "    double softClipLevel, softClipColor;\n"
    "};\n"
    "\n"
    "static const double SM_T5_SMIN = 0.35;             // flattest slope a compressive slot may reach\n"
    "static const double SM_T5_SMAX_ZONE = 1.0 / 0.35;\n"
    "static const double SM_T5_SMAX_CR = 2.0;           // steepest slope of the Camera Raw sliders\n"
    "static const double SM_T5_F_MIN = 0.05;\n"
    "static const double SM_T5_BLK_CRUSH = 3.0;         // Blacks -100 = -3 stops at black, +100 = +1\n"
    "static const double SM_T5_BLK_LIFT = 1.0;\n"
    "static const double SM_T5_HL_START = 0.0;         // the shoulder starts at grey: nothing below it moves\n"
    "static const double SM_T5_HL_TOP = 6.0;           // S-Log3's recorded top at the shot EI (+6.06..+6.17 measured)\n"
    "static const double SM_T5_HL_SMIN = 0.06;         // flattest slope of the shoulder\n"
    "static const double SM_T5_HL_CPLUS = 0.5;         // Highlights +100: slope at most 1.5\n"
    "static const double SM_T5_HL_MINPULL = 1.5;       // -100 always lowers the top this much, whatever Bianco says\n"
    "static const int SM_T5_ZONE_SLOT[4] = { 4, 6, 3, 0 };\n"
    "\n"
    "static inline SMToneControls sm_tone_defaults(void) {\n"
    "    SMToneControls c = SMToneControls();\n"
    "    const double range[4] = { -4.0, 1.0, -1.0, 4.0 }, falloff[4] = { 1.0, 2.0, 2.0, 1.0 };\n"
    "    for (int z = 0; z < 4; ++z) { c.zoneRange[z] = range[z]; c.zoneFalloff[z] = falloff[z]; }\n"
    "    c.softClipLevel = 2.5;\n"
    "    return c;\n"
    "}\n"
    "\n"
    "static inline double sm_clampd(double v, double lo, double hi) { return v < lo ? lo : (v > hi ? hi : v); }\n"
    "static inline double sm_contrast_map(double t, double c, double pivot) {\n"
    "    return c != 0.0 ? t + c * SM_T5_CON_R * tanh((t - pivot) / SM_T5_CON_R) : t;\n"
    "}\n"
    "static inline double sm_softplus2d(double y) { return (y > 0.0 ? y : 0.0) + log2(1.0 + exp2(-fabs(y))); }\n"
    "\n"
    "// Where the top must leave the shoulder so that it lands on `target`: on target itself, or with Soft Clip on\n"
    "// (roof at h) where the roof then brings it a tenth of a stop under target, not a third.\n"
    "static inline double sm_hl_landing(double target, int roofOn, double h) {\n"
    "    if (!roofOn) return target;\n"
    "    const double n = SM_T5_ROOF_N, ren = sm_softplus2d(-n * h) / n, want = fmin(target, h) - 0.1;\n"
    "    double lo = want, hi = want + 8.0;\n"
    "    for (int i = 0; i < 60; ++i) {\n"
    "        const double t = 0.5 * (lo + hi);\n"
    "        if (t + ren - sm_softplus2d(n * (t - h)) / n < want) lo = t; else hi = t;\n"
    "    }\n"
    "    return 0.5 * (lo + hi);\n"
    "}\n"
    "\n"
    "// D(u) of the Highlights shoulder (sm_t5_shoulder) in double.\n"
    "static inline double sm_shoulder_dd(double u) {\n"
    "    if (!(u > 0.0)) return 0.0;\n"
    "    const double f = SM_T5_HL_FILL, r = SM_T5_HL_RATE, m = SM_T5_HL_MID;\n"
    "    double ps;\n"
    "    if (u < f) {\n"
    "        const double v = u / f;\n"
    "        ps = f * (v * v * v - 0.5 * v * v * v * v);\n"
    "    } else {\n"
    "        ps = u - 0.5 * f;\n"
    "    }\n"
    "    return (sm_softplus2d(r * (ps - m)) - sm_softplus2d(-r * m)) / r;\n"
    "}\n"
    "\n"
    "// nominal[slot] = { E, edge, falloff, s_max } in scene stops. Edge and falloff go through Contrast and\n"
    "// the Highlights shoulder only, never through the other slots: that keeps every slot monotone in its own E.\n"
    "static inline void sm_zone_policy(double conC, double conPivot, const double nominal[SM_T5_SLOTS][4], SMToneCurve* c,\n"
    "                                  double hlE = 0.0, double hlStart = 0.0) {\n"
    "    *c = SMToneCurve();\n"
    "    c->conC = (float)conC;\n"
    "    c->conPivot = (float)conPivot;\n"
    "    if (hlE != 0.0) {\n"
    "        c->hlE = (float)hlE;\n"
    "        c->hlStart = (float)hlStart;\n"
    "    }\n"
    "    for (int i = 0; i < SM_T5_SLOTS; ++i) {\n"
    "        const double E = nominal[i][0], edge = nominal[i][1], f = nominal[i][2], smax = nominal[i][3];\n"
    "        if (E == 0.0) continue;\n"
    "        const double dir = i < SM_T5_UP ? 1.0 : -1.0;\n"
    "        double e0 = sm_contrast_map(edge, conC, conPivot), e1 = sm_contrast_map(edge + dir * f, conC, conPivot);\n"
    "        e0 += hlE * sm_shoulder_dd(e0 - hlStart);\n"
    "        e1 += hlE * sm_shoulder_dd(e1 - hlStart);\n"
    "        double fm = fabs(e1 - e0);\n"
    "        if (fm < SM_T5_F_MIN) fm = SM_T5_F_MIN;\n"
    "        const double lim = dir * E < 0.0 ? 1.0 - SM_T5_SMIN : smax - 1.0;\n"
    "        const double k1 = (double)SM_T5_RMAX / fm, k2 = lim / fabs(E);\n"
    "        c->zoneE[i] = (float)E;\n"
    "        c->zoneEdge[i] = (float)e0;\n"
    "        c->zoneK[i] = (float)(k1 < k2 ? k1 : k2);\n"
    "        c->zoneFill[i] = (float)(0.25 * fm);\n"
    "    }\n"
    "}\n"
    "\n"
    "// refSpace: the output gamut when the node converts to 709 / 2020 / P3, else Rec.2020.\n"
    "// expo: chosen EI / shot EI, which moves the recorded top Highlights -100 lands on Bianco (softClipLevel).\n"
    "static inline void sm_set_tone(DevelopParams* p, const SMToneControls* in, int outSpace, int convert,\n"
    "                               double expo = 1.0) {\n"
    "    SMToneControls v = *in;\n"
    "    v.contrast = sm_clampd(v.contrast, -100, 100); v.highlights = sm_clampd(v.highlights, -100, 100);\n"
    "    v.shadows = sm_clampd(v.shadows, -100, 100); v.whites = sm_clampd(v.whites, -100, 100);\n"
    "    v.blacks = sm_clampd(v.blacks, -100, 100); v.vibrance = sm_clampd(v.vibrance, -100, 100);\n"
    "    v.saturation = sm_clampd(v.saturation, -100, 100); v.zonePivot = sm_clampd(v.zonePivot, -4, 4);\n"
    "    for (int z = 0; z < 4; ++z) {\n"
    "        v.zoneExp[z] = sm_clampd(v.zoneExp[z], -6, 6);\n"
    "        v.zoneSat[z] = sm_clampd(v.zoneSat[z], -100, 100);\n"
    "        v.zoneRange[z] = sm_clampd(v.zoneRange[z], -10, 10);\n"
    "        v.zoneFalloff[z] = sm_clampd(v.zoneFalloff[z], 0.5, 6);\n"
    "    }\n"
    "    v.softClipLevel = sm_clampd(v.softClipLevel, 1, 10);\n"
    "    v.softClipColor = sm_clampd(v.softClipColor, -100, 100);\n"
    "\n"
    "    const double b = v.blacks / 100.0;\n"
    "    const double blkA = 1.0 - exp2((b < 0.0 ? SM_T5_BLK_CRUSH : SM_T5_BLK_LIFT) * b);\n"
    "    double blkRenorm = 0.0;\n"
    "    if (blkA != 0.0) {\n"
    "        const double grey = SM_T5_GREY, phi = SM_T5_BLK_PHI;\n"
    "        blkRenorm = log2(grey / (grey - blkA * phi * (1.0 - exp(-grey / phi))));\n"
    "    }\n"
    "\n"
    "    double nominal[SM_T5_SLOTS][4] = {};\n"
    "    const double sliders[2][5] = { { 1, 3.5, 1.0, 1.0, v.whites },\n"
    "                                   { 5, -1.0, 2.0, 2.0, v.shadows } };   // slot, edge, falloff, stops at 100, value\n"
    "    for (int s = 0; s < 2; ++s) {\n"
    "        double* n = nominal[(int)sliders[s][0]];\n"
    "        n[0] = sliders[s][3] * sliders[s][4] / 100.0; n[1] = sliders[s][1]; n[2] = sliders[s][2]; n[3] = SM_T5_SMAX_CR;\n"
    "    }\n"
    "    for (int z = 0; z < 4; ++z) {\n"
    "        double* n = nominal[SM_T5_ZONE_SLOT[z]];\n"
    "        n[0] = v.zoneExp[z]; n[1] = v.zoneRange[z]; n[2] = v.zoneFalloff[z]; n[3] = SM_T5_SMAX_ZONE;\n"
    "    }\n"
    "    const double conC = exp2(v.contrast / 100.0) - 1.0, white = v.softClipLevel;\n"
    "\n"
    "    // Highlights: the shoulder, eased. At -100 the recorded top, taken through Contrast as the start is, lands on\n"
    "    // Bianco (at least MINPULL under the top), unless the slope floor stops it first (Bianco under ~2.3).\n"
    "    double a = fabs(v.highlights) / 100.0, hlE = 0.0, hlAmount = 0.0, hlWhite = white;\n"
    "    a *= 1.5 - 0.5 * a;\n"
    "    const double hlStart = sm_contrast_map(SM_T5_HL_START, conC, v.zonePivot);\n"
    "    if (v.highlights > 0.0) {\n"
    "        hlE = a * SM_T5_HL_CPLUS;\n"
    "    } else if (v.highlights < 0.0) {\n"
    "        const double top = sm_contrast_map(SM_T5_HL_TOP + (expo > 0.0 ? log2(expo) : 0.0), conC, v.zonePivot);\n"
    "        const double land = sm_hl_landing(fmin(white, top - SM_T5_HL_MINPULL), v.softClip, v.softClipLevel);\n"
    "        const double D = sm_shoulder_dd(top - hlStart);\n"
    "        const double k = D > 0.0 ? fmin(fmax(top - land, 0.0) / D, 1.0 - SM_T5_HL_SMIN) : 0.0;\n"
    "        if (k > 0.0) {\n"
    "            hlE = -a * k;\n"
    "            hlAmount = a;\n"
    "            hlWhite = fmax(white, top - k * D);   // the taper sits where the top really lands\n"
    "        }\n"
    "    }\n"
    "    sm_zone_policy(conC, v.zonePivot, nominal, &p->curve, hlE, hlStart);\n"
    "\n"
    "    p->roofPurity = p->roofLin = 0.0f;\n"
    "    if (v.softClip != 0) {\n"
    "        const double h = v.softClipLevel, ren = sm_softplus2d(-(double)SM_T5_ROOF_N * h) / SM_T5_ROOF_N;\n"
    "        p->curve.roofOn = 1;\n"
    "        p->curve.roofStops = (float)h;\n"
    "        p->curve.roofRenorm = (float)ren;\n"
    "        p->roofPurity = (float)exp2(-v.softClipColor / 100.0);\n"
    "        p->roofLin = (float)(SM_T5_GREY * exp2(h + ren));\n"
    "    }\n"
    "    p->hlAmount = (float)hlAmount;\n"
    "    p->hlWhiteLin = hlAmount > 0.0 ? (float)(SM_T5_GREY * exp2(hlWhite)) : 0.0f;\n"
    "    p->hlTaperSpace = (convert && outSpace >= 1 && outSpace <= 5) ? outSpace : 1;\n"
    "    p->blkA = (float)blkA;\n"
    "    p->blkRenorm = (float)blkRenorm;\n"
    "    p->sat = (float)(v.saturation / 100.0);\n"
    "    p->vib = (float)(v.vibrance / 100.0);\n"
    "    int zoneOn = 0, zoneSatOn = 0;\n"
    "    for (int z = 0; z < 4; ++z) {\n"
    "        p->zSat[z] = (float)(v.zoneSat[z] / 100.0);\n"
    "        p->zNomEdge[z] = (float)v.zoneRange[z];\n"
    "        p->zNomInvF[z] = (float)(1.0 / v.zoneFalloff[z]);\n"
    "        zoneSatOn |= p->zSat[z] != 0.0f;\n"
    "    }\n"
    "    for (int i = 0; i < SM_T5_SLOTS; ++i) zoneOn |= p->curve.zoneE[i] != 0.0f;\n"
    "    p->toneOn = (blkA != 0.0 || p->curve.conC != 0.0f || p->curve.hlE != 0.0f || zoneOn) ? 1 : 0;\n"
    "    p->colorOn = (p->sat != 0.0f || p->vib != 0.0f || zoneSatOn) ? 1 : 0;\n"
    "    p->refSpace = (convert && outSpace >= 1 && outSpace <= 5) ? outSpace : SM_T5_REF;\n"
    "}\n"
    "#endif\n"
    "\n"
    "// ---- math/DetailHost.h\n"
    "// SPDX-License-Identifier: GPL-3.0-or-later\n"
    "// CPU only: the Detail node's parameters from the panel and the frame size, in double.\n"
    "#ifndef __METAL_VERSION__\n"
    "#include <algorithm>\n"
    "#include <vector>\n"
    "\n"
    "struct SMDetailControls {\n"
    "    double localContrast, localHighlights, localShadows, texture, clarity, dehaze;\n"
    "    double preserveDetail, detailRadius, edgeThreshold, noiseThreshold, clarityCenter, hazeLevel, hazeWarmth;\n"
    "    double localWhite;\n"
    "    int viewGain, viewBase, viewZones;            // viewZones: 0 off, 1 colours, 2 greys\n"
    "    int devMode, destination;                     // SM_DT_MODE_*, SM_DT_DEST_*\n"
    "    double adamsShadowL, adamsHighL, adamsShadowPlace, adamsHighPlace;  // Zonale: L read, zones placed on\n"
    "    double splitSoft, splitHard;                  // Split grade: stops of the soft and the hard exposure\n"
    "    int splitEngine;                              // SM_DT_ENGINE_*: how the two exposures join\n"
    "    int viewProvino, provinoKind;                 // the test print on the picture: SM_DT_PV_*\n"
    "    double provinoStep;                           // stops between neighbouring cells\n"
    "    int zonalPhase;                               // SM_DT_PHASE_*: Zonale in one node or in three\n"
    "    double printEdgeBurn, printEdgeSize;          // Zonale, print: stops burned at the edges, % of the frame\n"
    "};\n"
    "\n"
    "static const int SM_DT_GRID_BASE = 540;   // working height: H / s in [0.707, 1.414) * 540\n"
    "static const double SM_DT_HL_START = -0.5;  // Local Highlights starts half a stop under grey: the detail is kept there\n"
    "static const int SM_DT_MODE_ZONAL = 0, SM_DT_MODE_SPLIT = 1, SM_DT_MODE_UNITO = 2;   // Zonale (Ansel Adams), Split grade, Unito\n"
    "static const double SM_DT_SPLIT_RANGE = 3.0;                    // stops either way of each exposure\n"
    "static const double SM_DT_SPLIT_SHADOW_ZONE = 3.0, SM_DT_SPLIT_HIGH_ZONE = 8.0;   // where a print with both at 0 puts them\n"
    "static const int SM_DT_ENGINE_CURVE = 0, SM_DT_ENGINE_LAYERS = 1;   // one curve with a sliding pivot; two layers of paper\n"
    "static const double SM_DT_LAYER_HARD_GRADE = 5.0, SM_DT_LAYER_SOFT_GRADE = 0.0;   // what the two layers are\n"
    "static const int SM_DT_PV_STRIPS = 0, SM_DT_PV_MATRIX = 1, SM_DT_PV_UNIONS = 2;   // the test print's layouts\n"
    "// Unito: the negative's development takes the subject's range to the paper's as far as it can (N-/N+), the print's\n"
    "// grade the rest. Auto zone reads the shadow and the highlight at these percentiles of the picture.\n"
    "static const double SM_DT_UNITO_K_MIN = 0.5, SM_DT_UNITO_K_MAX = 2.0;\n"
    "static const double SM_DT_AUTO_LOW = 0.02, SM_DT_AUTO_HIGH = 0.98;\n"
    "static const double SM_DT_ADAMS_MIN_SPREAD = 0.25;\n"
    "// Zonale in phases, one node each (or all in one): development (global), print (local), presence (detail)\n"
    "static const int SM_DT_LG_MIN_H = 48;   // under it the zone views have no legend\n"
    "static const int SM_DT_PHASE_ALL = 0, SM_DT_PHASE_DEVELOP = 1, SM_DT_PHASE_PRINT = 2, SM_DT_PHASE_PRESENCE = 3;\n"
    "static const double SM_DT_ZD_K_MIN = 0.25, SM_DT_ZD_K_MAX = 4.0;   // development slope\n"
    "static const double SM_DT_ZD_ROOM = 1.0;   // toe and shoulder approach a stop beyond zone 0 and zone X\n"
    "// Destinations: manual (localWhite), Rec.709 CST, Rec.709 DRT, PQ 1000, scene (DaVinci WG/Intermediate, no ODT yet).\n"
    "// White and black in stops from grey: zone X and zone 0. Rec.709 CST: 2.5 + 4.5 = 7 stops.\n"
    "static const int SM_DT_DEST_COUNT = 5;\n"
    "static const double SM_DT_DEST_WHITE[SM_DT_DEST_COUNT] = { 0.0, 2.5, 4.5, 6.5, 9.0 };\n"
    "static const double SM_DT_DEST_BLACK[SM_DT_DEST_COUNT] = { 4.5, 4.5, 6.0, 7.0, 9.0 };\n"
    "static const double SM_DT_MIN_GAP = 0.05;   // two measured points closer than this (stops) are not a measure\n"
    "\n"
    "static inline SMDetailControls sm_detail_defaults(void) {\n"
    "    SMDetailControls c = SMDetailControls();\n"
    "    c.preserveDetail = 100.0;\n"
    "    c.detailRadius = 4.0;\n"
    "    c.edgeThreshold = 0.5;\n"
    "    c.noiseThreshold = 0.04;\n"
    "    c.hazeLevel = 2.0;\n"
    "    c.localWhite = 2.5;\n"
    "    c.adamsShadowPlace = 3.0;\n"
    "    c.adamsHighPlace = 8.0;\n"
    "    c.printEdgeSize = 30.0;\n"
    "    c.provinoStep = 0.5;\n"
    "    return c;\n"
    "}\n"
    "\n"
    "// The level the recorded top lands on: the node's own Bianco, or the destination's. And its black.\n"
    "static inline double dt_destination_white(const SMDetailControls* v) {\n"
    "    return v->destination >= 1 && v->destination < SM_DT_DEST_COUNT ? SM_DT_DEST_WHITE[v->destination] : v->localWhite;\n"
    "}\n"
    "static inline double dt_destination_black(const SMDetailControls* v) {\n"
    "    return v->destination >= 1 && v->destination < SM_DT_DEST_COUNT ? SM_DT_DEST_BLACK[v->destination]\n"
    "                                                                     : SM_DT_DEST_BLACK[0];\n"
    "}\n"
    "\n"
    "// A zone as log2 luminance out of the node, and back (math/Detail.h dt_zone_of): zone V grey, 0 black, X white.\n"
    "static inline double dt_zone_L(double z, double white, double black) {\n"
    "    return z <= 5.0 ? (z - 5.0) * black / 5.0 : (z - 5.0) * white / 5.0;\n"
    "}\n"
    "static inline double dt_L_zone(double L, double white, double black) {\n"
    "    return L <= 0.0 ? 5.0 + 5.0 * L / black : 5.0 + 5.0 * L / white;\n"
    "}\n"
    "\n"
    "// Zonale, development (tests/model/detail.py zonal_develop): exposure places the shadow on its zone, the slope\n"
    "// (N+/N-) turns the line about it so the highlight lands on its own. False without a measure.\n"
    "struct SMZonalDevelop { double Ls, Lso, k, hi, hiD, loD, sh, k2, Lh, Lho, k1; int two; };   // k1: Unito's development slope, 0 without\n"
    "// The grade of a slope and its inverse: 2.5 is normal, each doubling of the slope is 2.5 grades (hypothesis, to be\n"
    "// checked on prints: the sources give one grade per doubling of the soft/hard ratio).\n"
    "static inline double dt_split_grade(double k) { return 2.5 + 2.5 * log2(k); }\n"
    "static inline double dt_grade_slope(double g) { return exp2((g - 2.5) / 2.5); }\n"
    "\n"
    "// The curve at L (math/Detail.h dt_zonal_curve, in double): the line, or the lower of two lines, with toe and shoulder.\n"
    "static inline double dt_zonal_eval(const SMZonalDevelop* d, double L) {\n"
    "    double y = d->Lso + d->k * (L - d->Ls);\n"
    "    if (d->two) {\n"
    "        const double y2 = d->Lho + d->k2 * (L - d->Lh);\n"
    "        y = 0.5 * (y + y2 - sqrt((y - y2) * (y - y2) + 0.25));\n"
    "    }\n"
    "    if (y > d->sh) y = d->sh + d->hiD * (1.0 - exp(-(y - d->sh) / d->hiD));\n"
    "    else if (y < d->Lso) y = d->Lso - d->loD * (1.0 - exp(-(d->Lso - y) / d->loD));\n"
    "    return y;\n"
    "}\n"
    "\n"
    "static inline bool dt_zonal_develop(const SMDetailControls* v, SMZonalDevelop* d) {\n"
    "    const double Ls = v->adamsShadowL, Lh = v->adamsHighL, gap = Lh - Ls;\n"
    "    if (!(gap > SM_DT_MIN_GAP)) return false;\n"
    "    const double white = dt_destination_white(v), black = dt_destination_black(v);\n"
    "    double Lso, Lho;\n"
    "    const bool split = v->devMode != SM_DT_MODE_ZONAL;\n"
    "    if (split) {   // the print's two exposures: the soft one places the light, the hard one the shadow\n"
    "        Lso = dt_zone_L(SM_DT_SPLIT_SHADOW_ZONE, white, black) - v->splitHard;\n"
    "        Lho = fmax(dt_zone_L(SM_DT_SPLIT_HIGH_ZONE, white, black) - v->splitSoft, Lso + SM_DT_MIN_GAP);\n"
    "    } else {\n"
    "        const double zs = v->adamsShadowPlace, zh = fmax(v->adamsHighPlace, zs + SM_DT_ADAMS_MIN_SPREAD);\n"
    "        Lso = dt_zone_L(zs, white, black);\n"
    "        Lho = dt_zone_L(zh, white, black);\n"
    "    }\n"
    "    double Lh2 = Lh;\n"
    "    d->k1 = 0.0;\n"
    "    if (v->devMode == SM_DT_MODE_UNITO) {   // the development first, as far as N-/N+ go; the print takes the rest\n"
    "        d->k1 = sm_clampd((Lho - Lso) / gap, SM_DT_UNITO_K_MIN, SM_DT_UNITO_K_MAX);\n"
    "        Lh2 = Ls + d->k1 * gap;\n"
    "    }\n"
    "    const double gap2 = Lh2 - Ls;\n"
    "    d->Ls = Ls;\n"
    "    d->Lso = Lso;\n"
    "    d->Lh = Lh2;\n"
    "    d->Lho = Lho;\n"
    "    d->two = split && v->splitEngine == SM_DT_ENGINE_LAYERS ? 1 : 0;\n"
    "    if (d->two) {   // each layer is a line of its own grade; the paper takes the lower\n"
    "        d->k = dt_grade_slope(SM_DT_LAYER_HARD_GRADE);\n"
    "        d->k2 = dt_grade_slope(SM_DT_LAYER_SOFT_GRADE);\n"
    "        d->sh = Lho;\n"
    "    } else {\n"
    "        d->k = sm_clampd((Lho - Lso) / gap2, SM_DT_ZD_K_MIN, SM_DT_ZD_K_MAX);\n"
    "        d->k2 = 0.0;\n"
    "        d->sh = Lso + d->k * gap2;\n"
    "    }\n"
    "    d->hiD = fmax(white + SM_DT_ZD_ROOM - d->sh, 0.25);\n"
    "    d->loD = fmax(Lso + black + SM_DT_ZD_ROOM, 0.25);\n"
    "    d->hi = dt_zonal_eval(d, Lh2);\n"
    "    return true;\n"
    "}\n"
    "\n"
    "\n"
    "// The zones the shadow and the highlight land on: exact, unless the slope hits its limit.\n"
    "static inline void dt_zonal_reached(const SMDetailControls* v, double* zs, double* zh) {\n"
    "    const double white = dt_destination_white(v), black = dt_destination_black(v);\n"
    "    SMZonalDevelop d;\n"
    "    if (!dt_zonal_develop(v, &d)) {\n"
    "        *zs = dt_L_zone(v->adamsShadowL, white, black);\n"
    "        *zh = dt_L_zone(v->adamsHighL, white, black);\n"
    "        return;\n"
    "    }\n"
    "    *zs = dt_L_zone(d.Lso, white, black);\n"
    "    *zh = dt_L_zone(d.hi, white, black);\n"
    "}\n"
    "\n"
    "// n with 2 H^2 >= base^2 4^n, integers only: the grid does not jump between proxy and full size.\n"
    "static inline int dt_grid_scale(int H, int base) {\n"
    "    int n = 0;\n"
    "    while (2.0 * H * H >= (double)base * base * (double)(1LL << (2 * (n + 1)))) ++n;\n"
    "    return n;\n"
    "}\n"
    "\n"
    "static inline int dt_gauss_half(double sigma, float* half, int cap) {\n"
    "    int R = (int)ceil(3.0 * sigma);\n"
    "    if (R > cap - 1) R = cap - 1;\n"
    "    for (int k = 0; k <= R; ++k) half[k] = (float)exp(-k * k / (2.0 * sigma * sigma));\n"
    "    return R + 1;\n"
    "}\n"
    "\n"
    "// The veil in the input gamut: a neutral seen under a light of 10^6 / (153.8 + 0.8 v) K, norm 1.\n"
    "static inline void dt_veil(double warmth, int space, double out[3]) {\n"
    "    double w[3], w0[3], ls[3], l0[3], lms[3], d65[3] = { 0.95046, 1.0, 1.08906 }, xyz[3];\n"
    "    sm_white_xyz(1e6 / (153.8 + 0.8 * warmth), 0.0, w);\n"
    "    sm_white_xyz(1e6 / 153.8, 0.0, w0);\n"
    "    sm_bradford(w, ls, 0);\n"
    "    sm_bradford(w0, l0, 0);\n"
    "    sm_bradford(d65, lms, 0);\n"
    "    for (int i = 0; i < 3; ++i) lms[i] *= ls[i] / l0[i];\n"
    "    sm_bradford(lms, xyz, 1);\n"
    "    const float* m = SM_XYZ_TO_RGB + space * 9;\n"
    "    for (int i = 0; i < 3; ++i) {\n"
    "        const double c = m[i * 3] * xyz[0] + m[i * 3 + 1] * xyz[1] + m[i * 3 + 2] * xyz[2];\n"
    "        out[i] = c > 0.02 ? c : 0.02;\n"
    "    }\n"
    "    const double mx = fmax(out[0], fmax(out[1], out[2]));\n"
    "    double x = out[0] / mx, y = out[1] / mx, z = out[2] / mx;\n"
    "    double n = mx * (x * x * x + y * y * y + z * z * z) / (x * x + y * y + z * z);\n"
    "    if (n < 1e-3) n = 1e-3;\n"
    "    for (int i = 0; i < 3; ++i) out[i] /= n;\n"
    "}\n"
    "\n"
    "// href: the height the radii are relative to (the frame height; tests pass another to scale a small image).\n"
    "// Auto zone: the shadow and the highlight as the 2nd and 98th percentile of the picture's L (nearest rank), in stops.\n"
    "// L is sorted in place; false for too few samples.\n"
    "static inline bool dt_auto_zone(std::vector<float>& L, double* Ls, double* Lh) {\n"
    "    if (L.size() < 16) return false;\n"
    "    std::sort(L.begin(), L.end());\n"
    "    const double n1 = (double)(L.size() - 1);\n"
    "    *Ls = L[(size_t)floor(SM_DT_AUTO_LOW * n1 + 0.5)];\n"
    "    *Lh = L[(size_t)floor(SM_DT_AUTO_HIGH * n1 + 0.5)];\n"
    "    return true;\n"
    "}\n"
    "\n"
    "// Unito's first stage: the development, a bare line about the shadow (the shadow stays where it was read).\n"
    "static inline SMZdCurve dt_zd_first(const SMZonalDevelop* d) {\n"
    "    SMZdCurve c = SMZdCurve();\n"
    "    c.Ls = c.Lso = (float)d->Ls;\n"
    "    c.K = (float)d->k1;\n"
    "    c.kind = 2;\n"
    "    return c;\n"
    "}\n"
    "\n"
    "static inline SMZdCurve dt_zd_curve(const SMZonalDevelop* d, int mark) {\n"
    "    SMZdCurve c = SMZdCurve();\n"
    "    c.Ls = (float)d->Ls; c.Lso = (float)d->Lso; c.K = (float)d->k; c.Hi = (float)d->sh;\n"
    "    c.HiD = (float)d->hiD; c.LoD = (float)d->loD;\n"
    "    c.K2 = (float)d->k2; c.Lh = (float)d->Lh; c.Lho = (float)d->Lho;\n"
    "    c.kind = d->two;\n"
    "    c.mark = mark;\n"
    "    return c;\n"
    "}\n"
    "\n"
    "// The test print (provino): a grid of cells, each the picture developed with its own exposures. Strips: seven steps of\n"
    "// the soft exposure (top row) and of the hard one (bottom); matrix: soft across, hard down; unions: the two engines\n"
    "// side by side. The cell in the middle (or the engine in use) is the current one.\n"
    "static inline void dt_prepare_provino(DetailParams* p, int W, int H, const SMDetailControls* v) {\n"
    "    const int kind = v->provinoKind;\n"
    "    const int cols = kind == SM_DT_PV_STRIPS ? 7 : (kind == SM_DT_PV_MATRIX ? 5 : 2);\n"
    "    const int rows = kind == SM_DT_PV_STRIPS ? 2 : (kind == SM_DT_PV_MATRIX ? 5 : 1);\n"
    "    p->pvOn = 1;\n"
    "    p->pvCols = cols;\n"
    "    p->pvRows = rows;\n"
    "    p->pvBw = H / 270 > 1 ? H / 270 : 1;\n"
    "    for (int r = 0; r < rows; ++r)\n"
    "        for (int c = 0; c < cols; ++c) {\n"
    "            SMDetailControls cv = *v;\n"
    "            cv.devMode = SM_DT_MODE_SPLIT;\n"
    "            int mark = 0;\n"
    "            if (kind == SM_DT_PV_STRIPS) {\n"
    "                const double s = (c - cols / 2) * v->provinoStep;\n"
    "                (r == 0 ? cv.splitSoft : cv.splitHard) += s;\n"
    "                mark = c == cols / 2;\n"
    "            } else if (kind == SM_DT_PV_MATRIX) {\n"
    "                cv.splitSoft += (c - 2) * v->provinoStep;\n"
    "                cv.splitHard += (r - 2) * v->provinoStep;\n"
    "                mark = c == 2 && r == 2;\n"
    "            } else {\n"
    "                cv.splitEngine = c;\n"
    "                mark = c == v->splitEngine;\n"
    "            }\n"
    "            SMZonalDevelop d;\n"
    "            if (dt_zonal_develop(&cv, &d)) p->pv[r * cols + c] = dt_zd_curve(&d, mark);\n"
    "        }\n"
    "    (void)W;\n"
    "}\n"
    "\n"
    "static inline void dt_prepare(DetailParams* p, int W, int H, double href, double par, int space, int gamma,\n"
    "                              const SMDetailControls* in, int base) {\n"
    "    SMDetailControls v = *in;\n"
    "    v.localContrast = sm_clampd(v.localContrast, -100, 50);\n"
    "    v.localHighlights = sm_clampd(v.localHighlights, -100, 100);\n"
    "    v.localShadows = sm_clampd(v.localShadows, -100, 100);\n"
    "    v.texture = sm_clampd(v.texture, -100, 100);\n"
    "    v.clarity = sm_clampd(v.clarity, -100, 100);\n"
    "    v.dehaze = sm_clampd(v.dehaze, -100, 100);\n"
    "    v.preserveDetail = sm_clampd(v.preserveDetail, 0, 100);\n"
    "    v.detailRadius = sm_clampd(v.detailRadius, 1, 8);\n"
    "    v.edgeThreshold = sm_clampd(v.edgeThreshold, 0.25, 1.0);\n"
    "    v.noiseThreshold = sm_clampd(v.noiseThreshold, 0.0, 0.15);\n"
    "    v.clarityCenter = sm_clampd(v.clarityCenter, -3, 3);\n"
    "    v.hazeLevel = sm_clampd(v.hazeLevel, -2, 6);\n"
    "    v.hazeWarmth = sm_clampd(v.hazeWarmth, -100, 100);\n"
    "    v.localWhite = sm_clampd(v.localWhite, 1, 10);\n"
    "    v.devMode = v.devMode < 0 ? 0 : (v.devMode > SM_DT_MODE_UNITO ? SM_DT_MODE_UNITO : v.devMode);\n"
    "    v.splitSoft = sm_clampd(v.splitSoft, -SM_DT_SPLIT_RANGE, SM_DT_SPLIT_RANGE);\n"
    "    v.splitHard = sm_clampd(v.splitHard, -SM_DT_SPLIT_RANGE, SM_DT_SPLIT_RANGE);\n"
    "    v.splitEngine = v.splitEngine == SM_DT_ENGINE_LAYERS ? SM_DT_ENGINE_LAYERS : SM_DT_ENGINE_CURVE;\n"
    "    v.provinoKind = v.provinoKind < 0 ? 0 : (v.provinoKind > SM_DT_PV_UNIONS ? SM_DT_PV_UNIONS : v.provinoKind);\n"
    "    v.provinoStep = sm_clampd(v.provinoStep, 0.1, 1.5);\n"
    "    v.destination = v.destination < 0 ? 0 : (v.destination >= SM_DT_DEST_COUNT ? SM_DT_DEST_COUNT - 1 : v.destination);\n"
    "    v.viewZones = v.viewZones < 0 ? 0 : (v.viewZones > 2 ? 2 : v.viewZones);\n"
    "    v.adamsShadowL = sm_clampd(v.adamsShadowL, -16, 16);\n"
    "    v.adamsHighL = sm_clampd(v.adamsHighL, -16, 16);\n"
    "    v.adamsShadowPlace = sm_clampd(v.adamsShadowPlace, 0, 10);\n"
    "    v.adamsHighPlace = sm_clampd(v.adamsHighPlace, 0, 10);\n"
    "    v.zonalPhase = v.zonalPhase < 0 ? 0 : (v.zonalPhase > SM_DT_PHASE_PRESENCE ? SM_DT_PHASE_PRESENCE : v.zonalPhase);\n"
    "    v.printEdgeBurn = sm_clampd(v.printEdgeBurn, 0, 2);\n"
    "    v.printEdgeSize = sm_clampd(v.printEdgeSize, 10, 60);\n"
    "    // Zonale: each phase runs its own part; in one node (all) every part runs\n"
    "    const int phase = v.zonalPhase;   // Zonale and Split grade share the three phases and the development curve\n"
    "    const bool develop = phase == SM_DT_PHASE_ALL || phase == SM_DT_PHASE_DEVELOP;\n"
    "    const bool printing = phase == SM_DT_PHASE_ALL || phase == SM_DT_PHASE_PRINT;\n"
    "    const bool presence = phase == SM_DT_PHASE_ALL || phase == SM_DT_PHASE_PRESENCE;\n"
    "    if (!presence) v.texture = v.clarity = v.dehaze = 0.0;\n"
    "    if (!printing) v.localContrast = v.localShadows = v.localHighlights = 0.0;\n"
    "    const double radius = v.detailRadius;\n"
    "\n"
    "    *p = DetailParams();\n"
    "    p->W = W;\n"
    "    p->H = H;\n"
    "    p->space = space;\n"
    "    p->gamma = gamma;\n"
    "    const int n = dt_grid_scale(H, base);\n"
    "    p->s = 1 << n;\n"
    "    p->w = (W + p->s - 1) / p->s;\n"
    "    p->h = (H + p->s - 1) / p->s;\n"
    "    const double gh = href / p->s;\n"
    "    const double sigma1 = fmax(0.5, 0.0005 * href), sigma2 = 0.004 * href;\n"
    "    int nt = sigma2 > 0.0 ? (int)floor(log2(sigma2 / 4.0)) : 0;\n"
    "    nt = nt < 0 ? 0 : (nt > n ? n : nt);\n"
    "    p->st = 1 << nt;\n"
    "    p->wt = (W + p->st - 1) / p->st;\n"
    "    p->ht = (H + p->st - 1) / p->st;\n"
    "    const double tentVar = p->st >= 2 ? (2.0 * p->st * p->st + 1.0) / 12.0 : 0.0;\n"
    "    const double sigmaT = sqrt(fmax(sigma2 * sigma2 - tentVar, 0.25)) / p->st;\n"
    "    const double radii[5] = { radius / 100.0 * gh, 0.005 * gh, 0.025 * gh, 0.005 * gh, 0.02 * gh };\n"
    "    float* const rx[5] = { &p->rBx, &p->r2x, &p->r3x, &p->rpx, &p->rtx };\n"
    "    float* const ry[5] = { &p->rBy, &p->r2y, &p->r3y, &p->rpy, &p->rty };\n"
    "    for (int i = 0; i < 5; ++i) { *rx[i] = (float)(radii[i] / par); *ry[i] = (float)radii[i]; }\n"
    "    p->eps = (float)((v.edgeThreshold / 2.0) * (v.edgeThreshold / 2.0));\n"
    "    p->epsT = 0.01f;\n"
    "    p->nG = dt_gauss_half(1.0, p->gG, SM_DT_GG);\n"
    "    p->n1 = dt_gauss_half(sigma1, p->g1, SM_DT_G1);\n"
    "    p->nT = dt_gauss_half(sigmaT, p->gT, SM_DT_GT);\n"
    "\n"
    "    double nominal[SM_T5_SLOTS][4] = {};\n"
    "    for (int i = 0; i < SM_T5_SLOTS; ++i) { nominal[i][2] = 1.0; nominal[i][3] = SM_T5_SMAX_CR; }\n"
    "    const double sh[4] = { 0.02 * v.localShadows, 0.0, 1.5, SM_T5_SMAX_CR };   // the print has three local tones\n"
    "    for (int k = 0; k < 4; ++k) nominal[5][k] = sh[k];\n"
    "    sm_zone_policy(exp2(v.localContrast / 100.0) - 1.0, 0.0, nominal, &p->curve);\n"
    "    SMZonalDevelop zd;\n"
    "    if (develop && dt_zonal_develop(&v, &zd)) {\n"
    "        p->zdOn = 1;\n"
    "        p->zd = dt_zd_curve(&zd, 0);\n"
    "        if (zd.k1 != 0.0) {\n"
    "            p->zd1On = 1;\n"
    "            p->zd1 = dt_zd_first(&zd);\n"
    "        }\n"
    "        if (v.viewProvino && v.devMode == SM_DT_MODE_SPLIT) dt_prepare_provino(p, W, H, &v);\n"
    "    }\n"
    "    p->ebAmt = printing ? (float)v.printEdgeBurn : 0.0f;\n"
    "    p->ebS = (float)(v.printEdgeSize / 100.0);\n"
    "    p->ebR0 = 1.0f - p->ebS;\n"
    "    int slots = 0;\n"
    "    for (int i = 0; i < SM_T5_SLOTS; ++i) slots |= p->curve.zoneE[i] != 0.0f;\n"
    "    p->toneOn = (p->curve.conC != 0.0f || slots) ? 1 : 0;\n"
    "    // Local Highlights: the main node's shoulder, landing the recorded top on the node's own Bianco at -100\n"
    "    double amount = fabs(v.localHighlights) / 100.0;\n"
    "    amount *= 1.5 - 0.5 * amount;\n"
    "    if (v.localHighlights > 0.0) {\n"
    "        p->hlE = (float)(amount * SM_T5_HL_CPLUS);\n"
    "    } else if (v.localHighlights < 0.0) {\n"
    "        const double white = dt_destination_white(&v);\n"
    "        const double top = SM_T5_HL_TOP, land = fmin(white, top - SM_T5_HL_MINPULL);\n"
    "        const double D = sm_shoulder_dd(top - SM_DT_HL_START);\n"
    "        const double k = D > 0.0 ? fmin(fmax(top - land, 0.0) / D, 1.0 - SM_T5_HL_SMIN) : 0.0;\n"
    "        p->hlE = (float)(-amount * k);\n"
    "        p->hlAmount = (float)amount;\n"
    "        p->hlWhiteLin = (float)(SM_T5_GREY * exp2(fmax(white, top - k * D)));\n"
    "    }\n"
    "    p->hlTop = (float)SM_T5_HL_TOP;\n"
    "    p->hlStart = (float)SM_DT_HL_START;\n"
    "    // Soglia bordi sets what counts as detail: lower, fewer halos and less texture kept\n"
    "    p->hlT1 = (float)(0.7 * v.edgeThreshold);\n"
    "    p->hlT2 = (float)(0.6 * v.edgeThreshold);\n"
    "    p->hlB1 = (float)(0.3 * v.edgeThreshold);\n"
    "    p->hlB2 = (float)(0.2 * v.edgeThreshold);\n"
    "    p->lam = (float)(v.preserveDetail / 100.0);\n"
    "    p->tau0 = (float)v.noiseThreshold;\n"
    "    p->clarity = (float)(v.clarity / 100.0);\n"
    "    p->clarityCenter = (float)v.clarityCenter;\n"
    "    p->texture = (float)(v.texture / 100.0);\n"
    "\n"
    "    p->hazeOn = v.dehaze != 0.0 ? 1 : 0;\n"
    "    p->hazeOmega = v.dehaze > 0.0 ? (float)(0.006 * v.dehaze) : 0.0f;\n"
    "    p->hazeMix = v.dehaze < 0.0 ? (float)(0.5 * (v.dehaze / 100.0) * (v.dehaze / 100.0)) : 0.0f;\n"
    "    p->hazeLevel = (float)v.hazeLevel;\n"
    "    double veil[3];\n"
    "    dt_veil(v.hazeWarmth, space, veil);\n"
    "    for (int c = 0; c < 3; ++c) {\n"
    "        const double a = SM_T5_GREY * exp2(v.hazeLevel) * veil[c];\n"
    "        p->hazeA[c] = (float)a;\n"
    "        p->hazeInvA[c] = (float)(1.0 / a);\n"
    "    }\n"
    "    p->view = v.viewGain ? 1 : (v.viewBase ? 2 : (v.viewZones ? 2 + v.viewZones : 0));\n"
    "    p->zoneWhite = (float)dt_destination_white(&v);\n"
    "    p->zoneBlack = (float)dt_destination_black(&v);\n"
    "    p->pzOn = presence ? 1 : 0;\n"
    "    if (p->view >= 3 && H >= SM_DT_LG_MIN_H) {   // the legend: sizes follow the frame, ticks once measured\n"
    "        const int hb = H / 20 > 6 ? H / 20 : 6, m = W * 3 / 100 > 2 ? W * 3 / 100 : 2, span = W - 2 * m;\n"
    "        p->lgOn = 1;\n"
    "        p->lgM = m;\n"
    "        p->lgY0 = hb / 2;\n"
    "        p->lgY1 = p->lgY0 + hb;\n"
    "        p->lgSc = hb * 2 / 15 > 1 ? hb * 2 / 15 : 1;\n"
    "        p->lgTk = p->zdOn;\n"
    "        p->lgTh = p->lgTk ? hb * 2 / 3 : 0;\n"
    "        p->lgTw = hb / 12 > 1 ? hb / 12 : 1;\n"
    "        p->lgTop = p->lgY1 + p->lgTh + hb / 4;\n"
    "        p->lgX0 = m - hb / 4;\n"
    "        p->lgX1 = W - m + hb / 4;\n"
    "        const double white = p->zoneWhite, black = p->zoneBlack;\n"
    "        const double z[4] = { dt_L_zone(p->zd.Ls, white, black), dt_L_zone(v.adamsHighL, white, black),\n"
    "                              dt_L_zone(p->zd.Lso, white, black), dt_L_zone(zd.hi, white, black) };\n"
    "        int* tick[4] = { &p->lgIn[0], &p->lgIn[1], &p->lgOut[0], &p->lgOut[1] };\n"
    "        for (int k = 0; k < 4; ++k)\n"
