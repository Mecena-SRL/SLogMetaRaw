    "        const float nj = j / SM_A2_J_MAX, snj = SM_MAX(0.0f, 1.0f - nj), gi = 1.0f / SM_A2_CZ;\n"
    "        const float limit = SM_POW(nj, gi) * reach / mnorm;\n"
